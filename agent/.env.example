# Copy to .env and fill in. Never commit .env.
RPC_URL=https://testnet-rpc.monad.xyz
REGISTRY_ADDRESS=
# Private key of the agent's own wallet. Use a throwaway testnet wallet with a little MON for gas.
AGENT_PRIVATE_KEY=

# Optional. Leave AGENT_ID empty to reuse the identity this wallet already owns,
# or to register a new one with the name and description below on first run.
AGENT_ID=
AGENT_NAME=Runner
AGENT_DESCRIPTION="Autonomous reference agent that delivers tasks on its own."
